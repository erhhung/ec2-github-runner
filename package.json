{
  "name": "ec2-github-runner",
  "version": "4.0.0",
  "description": "GitHub Action for automatic creation and registration AWS EC2 instance as a GitHub Actions self-hosted runner.",
  "contributors": [
    {
      "name": "Volodymyr Machula"
    },
    {
      "name": "Erhhung Yuan"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:erhhung/ec2-github-runner.git"
  },
  "homepage": "https://github.com/erhhung/ec2-github-runner#readme",
  "bugs": {
    "url": "https://github.com/erhhung/ec2-github-runner/issues"
  },
  "scripts": {
    "lint": "eslint ./src/*.js",
    "index": "node -r dotenv/config ./src/index.js",
    "package": "ncc build ./src/index.js -o ./dist"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@aws-sdk/client-ec2": "^3.1033.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@vercel/ncc": "^0.38.4",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "globals": "^17.5.0"
  }
}
